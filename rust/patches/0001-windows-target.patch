diff --git a/gnosis_vpn-lib/src/wg_tunnel/tun_windows.rs b/gnosis_vpn-lib/src/wg_tunnel/tun_windows.rs
new file mode 100644
index 0000000..6d292e4
--- /dev/null
+++ b/gnosis_vpn-lib/src/wg_tunnel/tun_windows.rs
@@ -0,0 +1,105 @@
+//! Pump endpoint adapters over an in-process packet device (Windows).
+//!
+//! Windows has no TUN fd to pass between processes. The app that embeds the core owns
+//! the Wintun adapter and registers a [`PacketDevice`] with [`set_packet_device`]
+//! before it answers `SetupTunnel`; the connection runner then builds its reader and
+//! writer from that device here. One registered device serves every reconnect, so the
+//! adapter (and the TCP connections running through it) survives in-place reconnects.
+
+use std::io;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use tokio::sync::mpsc;
+
+use super::{TunReceiver, TunSender};
+
+/// A packet-oriented virtual network device: one call, one whole IP packet.
+pub trait PacketDevice: Send + Sync + 'static {
+    /// The next packet the system sent into the tunnel, or `Ok(None)` when none came
+    /// within `timeout`. An error means the device is gone.
+    fn recv_timeout(&self, timeout: Duration) -> io::Result<Option<Vec<u8>>>;
+    /// Injects one IP packet into the system's network stack.
+    fn send(&self, packet: &[u8]) -> io::Result<()>;
+}
+
+static DEVICE: Mutex<Option<Arc<dyn PacketDevice>>> = Mutex::new(None);
+
+/// Registers (or replaces) the device the next connection uses.
+pub fn set_packet_device(device: Arc<dyn PacketDevice>) {
+    *DEVICE.lock().unwrap_or_else(|e| e.into_inner()) = Some(device);
+}
+
+/// Forgets the registered device (the app is tearing the adapter down).
+pub fn clear_packet_device() {
+    *DEVICE.lock().unwrap_or_else(|e| e.into_inner()) = None;
+}
+
+/// Reader and writer over the registered device. The reader is fed by a dedicated
+/// thread that stops within one poll interval after the reader is dropped.
+pub fn device_endpoints() -> io::Result<(TunReader, TunWriter)> {
+    let device = DEVICE
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .clone()
+        .ok_or_else(|| io::Error::new(io::ErrorKind::NotConnected, "no packet device registered"))?;
+    let (tx, rx) = mpsc::channel::<io::Result<Vec<u8>>>(512);
+    let reader_device = device.clone();
+    std::thread::Builder::new()
+        .name("tun-reader".into())
+        .spawn(move || {
+            loop {
+                if tx.is_closed() {
+                    break;
+                }
+                match reader_device.recv_timeout(Duration::from_millis(250)) {
+                    Ok(Some(packet)) => {
+                        if tx.blocking_send(Ok(packet)).is_err() {
+                            break;
+                        }
+                    }
+                    Ok(None) => {}
+                    Err(e) => {
+                        let _ = tx.blocking_send(Err(e));
+                        break;
+                    }
+                }
+            }
+        })?;
+    Ok((TunReader { rx }, TunWriter { device }))
+}
+
+pub struct TunReader {
+    rx: mpsc::Receiver<io::Result<Vec<u8>>>,
+}
+
+pub struct TunWriter {
+    device: Arc<dyn PacketDevice>,
+}
+
+#[async_trait::async_trait]
+impl TunReceiver for TunReader {
+    async fn recv(&mut self, buf: &mut [u8]) -> io::Result<Option<usize>> {
+        loop {
+            match self.rx.recv().await {
+                None => return Ok(None),
+                Some(Err(e)) => return Err(e),
+                Some(Ok(packet)) => {
+                    if packet.len() > buf.len() {
+                        tracing::debug!(len = packet.len(), "dropping oversized packet from the tunnel device");
+                        continue;
+                    }
+                    buf[..packet.len()].copy_from_slice(&packet);
+                    return Ok(Some(packet.len()));
+                }
+            }
+        }
+    }
+}
+
+#[async_trait::async_trait]
+impl TunSender for TunWriter {
+    async fn send(&mut self, packet: &[u8]) -> io::Result<()> {
+        self.device.send(packet)
+    }
+}
