<Application x:Class="GnosisVpn.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <!-- SettingsCard keeps its control beside the text down to 200 px (the prototype's cards never stack) -->
      <x:Double x:Key="SettingsCardWrapThreshold">200</x:Double>
      <x:Double x:Key="SettingsCardWrapNoIconThreshold">200</x:Double>
      <ResourceDictionary.ThemeDictionaries>
        <!-- Gnosis lime as the Fluent accent (tokens.json: accent / accent-h / accent-p). -->
        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#3F6900</Color>
          <Color x:Key="SystemAccentColorLight1">#4A7810</Color>
          <Color x:Key="SystemAccentColorLight2">#5A8A20</Color>
          <Color x:Key="SystemAccentColorDark1">#3F6900</Color>
          <Color x:Key="SystemAccentColorDark2">#3A6200</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#9FD34A</Color>
          <Color x:Key="SystemAccentColorLight1">#9FD34A</Color>
          <Color x:Key="SystemAccentColorLight2">#93C63F</Color>
          <Color x:Key="SystemAccentColorLight3">#86B638</Color>
          <Color x:Key="SystemAccentColorDark1">#9FD34A</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
