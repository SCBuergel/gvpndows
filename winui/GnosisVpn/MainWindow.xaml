<Window x:Class="GnosisVpn.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TitleBar x:Name="TBar" Grid.Row="0" Height="48" Title="Gnosis VPN" IsBackButtonVisible="False" IsPaneToggleButtonVisible="False">
      <TitleBar.RightHeader><ContentPresenter x:Name="TRight" Margin="0,0,8,0" VerticalAlignment="Center" /></TitleBar.RightHeader>
    </TitleBar>
    <NavigationView x:Name="Nav" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False"
                    PaneDisplayMode="Auto" ExpandedModeThresholdWidth="1008" CompactModeThresholdWidth="641" OpenPaneLength="280" IsPaneToggleButtonVisible="True">
      <Grid>
        <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ContentPresenter x:Name="PageHost" />
        </ScrollViewer>
      </Grid>
    </NavigationView>
    <Grid x:Name="Solo" Grid.Row="1" Visibility="Collapsed" BorderThickness="0,1,0,0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ContentPresenter x:Name="SoloHost" />
      </ScrollViewer>
    </Grid>
    <Grid x:Name="Overlay" Grid.RowSpan="2" IsHitTestVisible="False">
      <Border x:Name="Snack" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,20" Padding="16,10" CornerRadius="6" BorderThickness="1" />
      <Border x:Name="Codes" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="8,3" CornerRadius="4" Opacity="0.85" />
    </Grid>
  </Grid>
</Window>
